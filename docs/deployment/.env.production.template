# ==========================================
# Miraim Production Environment Variables
# ==========================================
# このファイルをコピーして .env.production を作成し、
# 実際の値を設定してください
# 
# cp .env.production.template .env.production
# ==========================================

# ==================================
# 🔑 APIキー・認証情報（必須）
# ==================================

# OpenAI API設定
# 取得方法: https://platform.openai.com でアカウント作成 → API keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# JWT認証設定
# 生成方法: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# ==================================
# 🗄️ データベース設定（必須）
# ==================================

# Azure MySQL Flexible Server
MYSQL_HOST=your-mysql-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DATABASE=miraim_db
MYSQL_USER=miraimadmin
MYSQL_PASSWORD=YourStrongPassword2024!
MYSQL_SSL_DISABLED=false

# 統合データベースURL
# 形式: mysql+pymysql://ユーザー:パスワード@ホスト:ポート/データベース名?ssl_disabled=False
DATABASE_URL=mysql+pymysql://miraimadmin:YourStrongPassword2024!@your-mysql-server.mysql.database.azure.com:3306/miraim_db?ssl_disabled=False

# ==================================
# 🌐 アプリケーション設定（必須）
# ==================================

# 環境設定（本番環境では必ずproductionに設定）
NODE_ENV=production
ENVIRONMENT=production
ENV=production

# CORS設定（フロントエンドのURLを設定）
CORS_ORIGINS=["https://your-frontend-domain.azurecontainerapps.io"]
FRONTEND_ORIGIN=https://your-frontend-domain.azurecontainerapps.io

# ログレベル設定
LOG_LEVEL=ERROR

# ==================================
# 🚀 Azure Container Apps設定（必須）
# ==================================

# Azure Container Registry
ACR_LOGIN_SERVER=yourregistry.azurecr.io
ACR_USERNAME=yourregistry
ACR_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azureリソース情報
RESOURCE_GROUP=rg-miraim-prod
LOCATION=japaneast
CONTAINERAPPS_ENVIRONMENT=miraim-env

# アプリケーションURL（デプロイ後に設定）
BACKEND_URL=https://miraim-backend.xxxxx.azurecontainerapps.io
FRONTEND_URL=https://miraim-frontend.xxxxx.azurecontainerapps.io
NEXT_PUBLIC_API_URL=https://miraim-backend.xxxxx.azurecontainerapps.io

# ==================================
# 📊 モニタリング設定（オプション）
# ==================================

# Azure Log Analytics
WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WORKSPACE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================================
# 🔒 追加のセキュリティ設定（オプション）
# ==================================

# Azure Key Vault（使用する場合）
# KEY_VAULT_NAME=miraim-keyvault
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==================================
# 📝 メモ
# ==================================
# 1. このファイルは絶対にGitにコミットしないでください
# 2. 本番環境では Azure Key Vault の使用を推奨します
# 3. パスワードは定期的に変更してください
# 4. APIキーの使用量を定期的に監視してください
# ==================================